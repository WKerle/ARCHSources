   Basso, A. and Maiezza, P. and Tata, A. and Giannangeli, A.},
Editor = {GonzalezAguilera, D and Remondino, F and Toschi, I and RodriguezGonzalvez, P and Stathopoulou, E},
Title = {EXPERIENCING THE INACCESSIBLE. A FRAMEWORK FOR VIRTUAL INTERPRETATION
   AND VISUALIZATION OF REMOTE, RISKY OR RESTRICTED ACCESS HERITAGE PLACES},
