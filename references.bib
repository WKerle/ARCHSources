Title = {Flowing with Zen: Exploring Empowering the Intangible Cultural Heritage
   via Immersive Mixed Reality Spaces},
Booktitle = {2024 IEEE CONFERENCE ON VIRTUAL REALITY AND 3D USER INTERFACES ABSTRACTS
   AND WORKSHOPS, VRW 2024},
Year = {2024},
Pages = {705-706},
Note = {IEEE Conference on Virtual Reality and 3D User Interfaces (VR), Orlando,
   FL, MAR 16-21, 2024},
Abstract = {Zen is a treasure of the world's intangible cultural heritage (ICH), but
   nowadays it is facing difficulties in dissemination. This paper presents
   an immersive experience space Flowing with Zen by integrating HCI
   technology and mixed reality (MR). Audiences can explore and interact
   with the four scenarios, as well as meditate, and experience Zen
   philosophy. The pilot study shows that the MR space not only evokes
   users' interest and participation but also deepens their empathy or
   reflections. This innovative way of combining MR, ICH, and experience
   enhances the accessibility of Zen, and it may open up a new mode of
   dissemination for ICH.},
