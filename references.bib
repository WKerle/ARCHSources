}

@article{ WOS:000740552000011,
Author = {Taccola, Emanuele and Rosselli, Lisa and Albertini, Niccolo and Martino,
   Marta},
Title = {ETRUSCAN HYPOGEA IN 3D: A PROPOSAL FOR AN IMMERSIVE AND INTERACTIVE
   VISUALIZATION OF VOLTERRA'S FUNERARY CONTEXTS},
Journal = {ARCHEOLOGIA E CALCOLATORI},
Year = {2021},
Volume = {32},
Number = {2},
Pages = {135-152},
Abstract = {This article describes an interdisciplinary study carried out by a team
   of archaeologists, 3D surveyors and experts of new technologies applied
   to cultural heritage. The research was aimed at developing a virtual
   reality experience dedicated to Etruscan hypogean tombs in the city of
   Volterra. The application, intended for non-expert users, has been
   implemented in a touch screen version (mobile devices) as well as in VR
