Keywords = {Zen culture; intangible cultural heritage; human-computer interaction;
   immersive mixed reality space; user experience},
Research-Areas = {Computer Science},
Unique-ID = {WOS:001239375400143},
}

@article{ WOS:000988814300005,
Author = {Zhang, Lu and Ji, Shaojun and Shi, Meiyu},
Title = {A study of integration application based on 5G/8K/AI/VR for the
   activation of intangible cultural heritage},
Journal = {INTERNATIONAL JOURNAL OF COMPUTER APPLICATIONS IN TECHNOLOGY},
Year = {2022},
Volume = {70},
Number = {3-4},
Pages = {197-214},
Abstract = {Within the culture and tourism field, the activation of intangible
   cultural heritage has been a hot topic in recent years. A major way of
   doing that is through leveraging various cutting-edge technologies, in
   particular, 5G/8K/AI/VR. However, due to the diversity of intangible
   culture and inescapable relationships among different technologies, it
   is necessary to consider the integration application of the advanced
   technologies. There is a trend that the said technologies are often used
   to construct the immersive experience. A related embodied cognition
   theory is referred in this paper to build the theoretical basis. Then, a
   detailed analysis of the functions and features of 5G/8K/AI/VR is
   followed. Based on the research efforts, several integration application
   scenarios are summarised through case study for the activation of
   intangible cultural heritage.},
