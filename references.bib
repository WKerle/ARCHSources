Keywords = {mixed reality; interactivity; vividness; brand loyalty; brand awareness;
   brand association; cultural heritage attractions},
Keywords-Plus = {IMMERSIVE VIRTUAL-REALITY; CUSTOMER-BASED BRAND; AUGMENTED REALITY;
