Research-Areas = {Arts \& Humanities - Other Topics; Computer Science; Information Science
   \& Library Science},
Unique-ID = {WOS:000455871900063},
}

@article{ WOS:001232937200001,
Author = {Zhang, Yuxin and Zhang, Boning and Jang, Wansok and Pan, Younghwan},
Title = {Enhancing Spatial Cognition in Online Virtual Museum Environments:
   Integrating Game-Based Navigation Strategies for Improved User
   Experience},
Journal = {APPLIED SCIENCES-BASEL},
Year = {2024},
Volume = {14},
Number = {10},
Month = {MAY},
Abstract = {Online Virtual Museums (OVM) serve as vital conduits for the global
   propagation of cultural heritage but grapple with the challenge of user
   disorientation due to the absence of physical references. Leveraging the
   successful paradigm of game-based virtual navigation, this study
   investigates the potential integration of game mini-map navigation
   design elements into OVM to enhance spatial cognition. Through empirical
   investigation, a conceptual model was developed to probe the role of
   core mini-map design elements (interactivity, visual guidance, and
   information content) in augmenting spatial cognition. Results indicate
   that optimizing these elements significantly enhances user immersion and
   presence, thereby improving spatial cognition. Specifically, information
   content and visual guidance exerted stronger effects on immersion and
   presence, respectively. This research contributes a novel perspective on
   incorporating game design strategies into non-game virtual experiences,
   offering practical guidance for enhancing navigation in OVM and similar
   virtual environments. This bridges the gap between virtual museum
   navigation and game design, propelling the evolution of more dynamic,
   interactive, and user-centric virtual environments, thus fostering the
   preservation and dissemination of digital cultural heritage.},
Publisher = {MDPI},
Address = {MDPI AG, Grosspeteranlage 5, CH-4052 BASEL, SWITZERLAND},
Type = {Article},
DOI = {10.3390/app14104163},
Article-Number = {4163},
EISSN = {2076-3417},
Keywords = {online virtual museums; spatial cognition; mini-map; navigation design;
   game design elements},
Keywords-Plus = {SYSTEM; REALITY; VISITORS; WEBSITES; ROUTE; WORLD; MAPS; ART},
Research-Areas = {Chemistry; Engineering; Materials Science; Physics},
Unique-ID = {WOS:001232937200001},
}

@article{ WOS:001380530900012,
Author = {Duester, Emma},
Title = {Creating an Ethical and Sustainable Framework for Digitization Projects
   at Cultural Heritage Museums in Vietnam},
Journal = {INTERNATIONAL JOURNAL OF THE INCLUSIVE MUSEUM},
Year = {2025},
Volume = {18},
Number = {1},
Pages = {233-252},
Month = {JUN},
Abstract = {Cultural heritage museums globally are currently undergoing rapid
   digital transformation. However, cultural heritage museums in Vietnam
   face challenges in systematically and comprehensively digitizing
   collections because of a lack of technical, financial, and skilled human
   resources. Currently, museum professionals must carry out digitization
   projects with a deficiency in technical equipment to properly scan
   cultural artifacts, a lack of digitally skilled staff, and a slowly
   developing internet infrastructure. This study draws on a codesigned
   digitization project between RMIT University, the Vietnamese Women's
   Museum, and the Vietnamese National Museum of Fine Arts from 2020 to
   2023 that included interviews, consultations, and the digitization of
   twelve museum artifacts. An ethics and sustainability framework was
   developed and used in this study to ensure the inclusion of (1) local
   context, (2) local culture, and (3) local stakeholders' voices. The
   findings highlight a ``global digitization divide,{''} where
   country-specific limitations affect the amount and pace of Vietnamese
   digital culture that can be produced as well as the quality of
   experiences when accessing, viewing, and engaging with the digital
   culture. Consequently, the creation of more complex digital culture,
   such as immersive augmented reality or virtual reality environments, is
   currently unfeasible. This highlights the need to investigate Vietnamese
   museum professionals' capabilities and challenges as they undergo
   digital transformation and, in response, design an ethical and
   sustainable framework for museum digitization projects.},
