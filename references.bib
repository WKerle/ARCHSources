   and Peluso, R. and Petriaggi, B. Davidde and Petriaggi, R. and Rizvic,
   S. and Skarlatos, D.},
Editor = {Skarlatos, D and Agrafiotis, P and Nocerino, E and Menna, F and Bruno, F and Vlachos, M},
Title = {VIRTUAL TOUR IN THE SUNKEN ``VILLA CON INGRESSO A PROTIRO{''} WITHIN THE
   UNDERWATER ARCHAEOLOGICAL PARK OF BAIAE},
Booktitle = {UNDERWATER 3D RECORDING AND MODELLING: A TOOL FOR MODERN APPLICATIONS
