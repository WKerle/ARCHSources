   ICALT 2024},
Series = {IEEE International Conference on Advanced Learning Technologies},
Year = {2024},
Pages = {269-271},
Note = {24th IEEE International Conference on Advanced Learning Technologies
   (ICALT), Nicosia, CYPRUS, JUL 01-04, 2024},
Abstract = {This study employed multimodal learning analytics methods to evaluate
   different virtual reality (VR) interfaces, exploring their impact on the
   learning experience of cultural heritage. We recorded and analyzed the
   participants' learning behavior, self-reported perceptions from
   questionnaires' responses, electroencephalogram (EE(;) signals, and
   visual fatigue. Preliminary results suggested that VR interfaces with
   more modules per scene led to higher efficiency of use, although more
   modules did not improve viewing experience. This study provides insights
   for immersive interface design in cultural heritage learning.},
