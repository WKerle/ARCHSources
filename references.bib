Unique-ID = {WOS:000227346700028},
}

@inproceedings{ WOS:001327687600100,
Author = {Rini, Maria Nita Anggia and Nendya, Matahari Bhakti and Santoso, Halim
   Budi and Senapartha, I. Kadek Dendy and Prabawati, Andhika Galuh and
   Delima, Rosa and Wuttisittikulkij, Lunchakorn and Tanmalapom, Tanakom
   and La-aiddee, Panithan and Yamyuan, Ittipon and Aung, Nang Htet Htet
   and Penata, Grace Shinta Esther},
Book-Group-Author = {IEEE},
Title = {Integrating DutaVerse with the Cultural Exhibition Hall in the Metaverse
   Academic Nexus Virtual Education Ecosystem},
Booktitle = {2024 INTERNATIONAL TECHNICAL CONFERENCE ON CIRCUITS/SYSTEMS, COMPUTERS,
   AND COMMUNICATIONS, ITC-CSCC 2024},
