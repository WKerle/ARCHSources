@inproceedings{ WOS:001336528300010,
Author = {Sasso, Gaia and Evangelista, Chiara and Giuliodori, Giovanni and
   Carrozzino, Marcello},
Editor = {DePaolis, LT and Arpaia, P and Sacco, M},
Title = {OcuLeO: Immersive VR Learning Adventure},
Booktitle = {EXTENDED REALITY, PT IV, XR SALENTO 2024},
Series = {Lecture Notes in Computer Science},
Year = {2024},
Volume = {15030},
Pages = {141-160},
Note = {International Conference on Extended Reality (XR Salento), Lecce, ITALY,
   SEP 04-07, 2024},
Abstract = {Virtual Reality (VR) is a technology that has been widely adopted by the
   gaming industry. However, it also has potential applications in
   education, simulation, and training. This paper presents a possible
   application of VR integrated into a larger path of education and
   workshops, serving as an aid to engage students and increase their
   enthusiasm about the present subject.
   The OcuLeO project is an immersive educational experience based on VR
   technologies. It is designed for young people to step into the shoes of
   the great inventor and innovator, Leonardo da Vinci, to stimulate
   creativity and problem-solving skills. The project was conceived and
   designed as part of the European eCHOing project, in collaboration
   between the Institute of Mechanical Intelligence of the Sant'Anna School
   of Advanced Studies of Pisa and the Museo Leonardiano di Vinci. The
   study involved creating an application through coding and modelling
   phases and developing a coherent storyline. Testing sessions were
   conducted across Europe, interviewing users and obtaining qualitative
   and quantitative feedback on perceptions of the experience.},
Publisher = {SPRINGER INTERNATIONAL PUBLISHING AG},
Address = {GEWERBESTRASSE 11, CHAM, CH-6330, SWITZERLAND},
